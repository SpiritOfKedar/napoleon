# Copy to .env and adjust. docker compose reads .env automatically.
# Every value here has a default in docker-compose.yml, so .env is optional for a local run.

# --- PostgreSQL ---
POSTGRES_DB=napoleon
POSTGRES_USER=napoleon
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Ports exposed on the host ---
FRONTEND_PORT=4200
BACKEND_PORT=8080
TRANSCRIPTION_PORT=8000

# --- Transcription (Python service) ---
# Which engine turns speech into text:
#   local  = faster-whisper in the container. Free and private. Speed depends on your CPU.
#   groq   = Groq's hosted whisper-large-v3-turbo. Most accurate and by far the fastest
#            (an hour of audio in about a minute), roughly $0.04 per audio hour. Audio leaves
#            your machine. Needs GROQ_API_KEY (console.groq.com).
#   openai = OpenAI's transcription API. Needs OPENAI_API_KEY.
WHISPER_BACKEND=local
# Local model. Measured on an 8-core laptop CPU, 5 min of interview audio, batched:
#   base            19x realtime  frequent word errors ("about his eyes" for "about AI")
#   small           14x realtime  clearly better wording (default)
#   large-v3-turbo   4x realtime  best local accuracy, ~1.6 GB download
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Decode several speech chunks at once (0 = sequential). 8 was fastest on 8 cores; 16 was slower.
WHISPER_BATCH_SIZE=8
# 1 = greedy (fast). 5 = beam search, ~35% slower, slightly better on noisy audio.
WHISPER_BEAM_SIZE=1
# Leave empty to auto-detect the spoken language (e.g. en, hi, ta).
WHISPER_LANGUAGE=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WHISPER_MODEL=whisper-1
# Load models when the service starts (otherwise on the first request).
PRELOAD_MODELS=true
# Files transcribed at once; more would just compete for the same CPU cores.
WHISPER_CONCURRENCY=1
# CPU threads per transcription (0 = let CTranslate2 decide).
WHISPER_CPU_THREADS=0
# Long recordings are transcribed in windows of this many seconds, keeping memory flat.
TRANSCRIBE_WINDOW_SEC=1800
# Hosted APIs cap uploads at 25 MB, so audio goes up as 32 kbit/s MP3 in windows this long.
OPENAI_WINDOW_SEC=1200

# --- Embeddings and search ---
# multilingual-e5-small understands ~100 languages (English, Hindi, Tamil, Telugu, ...), and a
# query in one language can find speech in another. EMBEDDING_DIM must match the model and is
# baked into the DB schema on first start. Switching to another 384-dim model is automatic:
# indexed files are re-embedded from their stored text on the next start.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBED_BATCH_SIZE=32
# Cross-encoder that re-scores the top candidates against the query, so exact wording counts.
# Set to empty to turn reranking off (faster queries, weaker ranking).
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Candidates the reranker looks at per query.
SEARCH_CANDIDATES=30

# --- Chunking (seconds) ---
CHUNK_WINDOW_SEC=30
CHUNK_OVERLAP_SEC=5

# --- Backend ---
MAX_UPLOAD_SIZE=5GB
# Comma-separated. Only needed when the UI is served from a different origin (e.g. ng serve).
CORS_ALLOWED_ORIGINS=http://localhost:4200
PROCESSING_WORKER_THREADS=2
SEARCH_DEFAULT_LIMIT=10
# Only for the upload-based fallback (when the media volume is not shared).
TRANSCRIPTION_READ_TIMEOUT=60m
# Longest gap between lines on the transcription stream (it carries heartbeats).
TRANSCRIPTION_STREAM_IDLE_TIMEOUT=5m

# --- Seed ---
# Upload infra/sample/sample-meeting.wav on first start so search works out of the box.
SEED_SAMPLE=true
