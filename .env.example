# Copy to .env and adjust. docker compose reads .env automatically.
# Every value here has a default in docker-compose.yml, so .env is optional for a local run.

# --- PostgreSQL ---
POSTGRES_DB=napoleon
POSTGRES_USER=napoleon
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Ports exposed on the host ---
FRONTEND_PORT=4200
BACKEND_PORT=8080
TRANSCRIPTION_PORT=8000

# --- Transcription (Python service) ---
# local = faster-whisper in the container; openai = OpenAI transcription API (needs OPENAI_API_KEY).
WHISPER_BACKEND=local
# tiny | base | small | medium | large-v3   (bigger = more accurate, much slower on CPU)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave empty to auto-detect the spoken language.
WHISPER_LANGUAGE=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WHISPER_MODEL=whisper-1
# Load models when the service starts (otherwise on the first request).
PRELOAD_MODELS=true

# --- Embeddings ---
# EMBEDDING_DIM must match the model's output and is baked into the DB schema on first start.
# Changing either later requires wiping the database volume (or a new migration) and re-indexing.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBED_BATCH_SIZE=32

# --- Chunking (seconds) ---
CHUNK_WINDOW_SEC=30
CHUNK_OVERLAP_SEC=5

# --- Backend ---
MAX_UPLOAD_SIZE=500MB
# Comma-separated. Only needed when the UI is served from a different origin (e.g. ng serve).
CORS_ALLOWED_ORIGINS=http://localhost:4200
PROCESSING_WORKER_THREADS=2
SEARCH_DEFAULT_LIMIT=10
TRANSCRIPTION_READ_TIMEOUT=60m

# --- Seed ---
# Upload infra/sample/sample-meeting.wav on first start so search works out of the box.
SEED_SAMPLE=true
