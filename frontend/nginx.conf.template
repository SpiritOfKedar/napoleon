# Rendered by the nginx image's envsubst step; ${BACKEND_UPSTREAM} comes from docker-compose.
server {
    listen 80;
    root /usr/share/nginx/html;

    # The backend enforces MAX_UPLOAD_SIZE and returns a proper JSON 413, so don't limit here.
    client_max_body_size 0;

    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        # Stream uploads straight through (real progress) and media straight back (fast seeking).
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    # SPA: unknown paths fall back to index.html so deep links like /player/1?t=30 work.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
